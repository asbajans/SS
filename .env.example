


# ===== Core (Portainer env alanına girilecek; bu dosya repoya örnek için) =====

# PostgreSQL
POSTGRES_USER=crowdscope
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=crowdscope

# App
SECRET_KEY=change-me-64-bytes-random
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=120
REFRESH_TOKEN_TTL_DAYS=30
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me

# Object storage
MINIO_ROOT_USER=crowdscope
MINIO_ROOT_PASSWORD=change-me-long-random
MINIO_BUCKET=crowdscope

# Embedding service (d Flat: TEI)
TEI_URL=http://tei:80
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ===== LLM: OpenRouter (tek dış bağımlılık) =====
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# hesap geneli harcama tavanı (USD) — ayrıca OpenRouter panelinde de ayarla
OPENROUTER_MONTHLY_CAP_USD=50
# 1=mock mode (CI/dev; API key olmadan çalışır)
LLM_MOCK_MODE=0

# Task bazlı varsayılanlar (override edilebilir; DB model_configs authority'dir)
LLM_TASK_DEFAULT_AGENT_ACT=meta-llama/llama-3.1-8b-instruct
LLM_TASK_DEFAULT_REPORT_SECTION=anthropic/claude-sonnet-4

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_USD_MONTHLY_CAP=

# Site
PUBLIC_BASE_URL=https://app.example.com
APP_NAME=Social Simulation
COMPANY_NAME=Example LLC
COMPANY_STATE=New Mexico
CONTACT_EMAIL=support@example.com
PRIVACY_EMAIL=privacy@example.com

# ===== Cloudflare =====
CLOUDFLARE_TUNNEL_TOKEN=

# ===== Limits / engine defaults =====
ENGINE_MAX_AGENTS=300
ENGINE_MAX_ROUNDS=80
ENGINE_DEFAULT_CONCURRENCY=30
RATE_LIMIT_ENABLE=1

# ===== Observability (F4) =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-long-random
